root = true

# Defaults for new and edited source; does not retroactively rewrite history.
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csproj,props,targets}]
indent_style = space
indent_size = 4

[*.{json,yml,yaml,md}]
indent_style = space
indent_size = 2

# Windows PowerShell 5.1 needs a UTF-8 BOM to read Japanese correctly.
[*.ps1]
charset = utf-8-bom
end_of_line = crlf
indent_style = space
indent_size = 4

[*.bat]
end_of_line = crlf
